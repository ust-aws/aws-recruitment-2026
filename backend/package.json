{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "test": "./smoke-test.sh",
    "test:validation": "tsx --test src/lib/apply/field-validation.test.ts",
    "test:schemas": "tsx --test src/lib/apply/schemas.test.ts",
    "test:db": "tsx --test --test-concurrency=1 src/db/schema.test.ts",
    "test:email": "tsx --test src/lib/email/templates.test.ts src/lib/email/interview-calendar.test.ts src/lib/email/interview-email-templates.test.ts src/lib/email/officer-recipients.test.ts",
    "test:reminders": "tsx --test src/lib/interview/reminders.test.ts",
    "test:editing": "tsx --test --test-concurrency=1 src/applicant-editing.test.ts",
    "test:decisions": "tsx --test --test-concurrency=1 src/application-decisions.test.ts",
    "test:otp": "tsx --test --test-concurrency=1 src/applicant-auth.test.ts",
    "test:scheduling": "tsx --test --test-concurrency=1 src/interview-scheduling.test.ts",
    "test:results": "tsx --test --test-concurrency=1 src/results-preview.test.ts",
    "test:archive": "tsx --test --test-concurrency=1 src/application-archiving.test.ts",
    "test:listing": "tsx --test --test-concurrency=1 src/application-listing.test.ts",
    "test:season": "tsx --test src/lib/recruitment/window.test.ts && tsx --env-file=../.env --test --test-concurrency=1 src/recruitment-season.test.ts",
    "test:security": "tsx --test src/trusted-origin.test.ts && tsx --env-file=../.env --test --test-concurrency=1 src/hr-auth.test.ts src/security-access.test.ts",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "db:push": "node --env-file-if-exists=../.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:sync": "node --env-file-if-exists=../.env scripts/sync-schema.mjs",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-presigned-post": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@hono/node-server": "^1.14.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "bcryptjs": "^3.0.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1118.2",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.4.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
