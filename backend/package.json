{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "test": "./smoke-test.sh",
    "test:db": "tsx --test --test-concurrency=1 src/db/schema.test.ts",
    "test:email": "tsx --test src/lib/email/templates.test.ts",
    "test:editing": "tsx --test --test-concurrency=1 src/applicant-editing.test.ts",
    "test:otp": "tsx --test --test-concurrency=1 src/applicant-auth.test.ts",
    "test:scheduling": "tsx --test --test-concurrency=1 src/interview-scheduling.test.ts",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "db:push": "node --env-file=../.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1118.2",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.4.2",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
