# --- Local dev (docker-compose postgres) ---
# Port 5434, not 5432 — this machine already has other projects' postgres
# containers bound to 5432 and 5433. Adjust POSTGRES_PORT if 5434 is also taken.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aws_ust_recruitment
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/aws_ust_recruitment

# --- Deployed (Neon) ---
# Use Neon's *pooled* connection string, not the direct one — Lambda's
# connection churn will exhaust a direct Postgres connection limit fast.
# DATABASE_URL=postgres://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# --- Backend ---
PORT=8787
CORS_ORIGIN=http://localhost:3000

# --- Frontend (copy into frontend/.env.local — Next does not read the repo root) ---
# Same host/port as PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- HR auth (single shared account; not the users table) ---
HR_EMAIL=hr@aws-ust.org
HR_PASSWORD=changeme
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- CDK deploy target (yours to fill in when you deploy) ---
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=ap-southeast-1
