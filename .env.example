# --- Local dev (docker-compose postgres) ---
# Port 5434, not 5432 — this machine already has other projects' postgres
# containers bound to 5432 and 5433. Adjust POSTGRES_PORT if 5434 is also taken.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aws_ust_recruitment
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/aws_ust_recruitment

# --- Deployed (Neon) ---
# Use Neon's *pooled* connection string, not the direct one — Lambda's
# connection churn will exhaust a direct Postgres connection limit fast.
# DATABASE_URL=postgres://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# --- Backend ---
PORT=8787
CORS_ORIGIN=http://localhost:3000
S3_BUCKET=aws-ust-recruitment-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# Required for CDK deployment. Use an ISO-8601 UTC timestamp at least seven days away.
BUDGET_ALERT_EMAIL=you@example.com
FREE_PLAN_END_DATE=2027-01-01T00:00:00.000Z

# --- Frontend (copy into frontend/.env.local — Next does not read the repo root) ---
# Same host/port as PORT above.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# --- HR auth (single shared account; not the users table) ---
HR_EMAIL=hr@aws-ust.org
HR_PASSWORD=changeme
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Applicant OTP auth (separate from HR sessions; use 32+ random characters) ---
APPLICANT_AUTH_SECRET=change-me-to-a-different-long-random-string

# --- Gmail API (backend only — copy values into .env; never commit real secrets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_NAME=AWS Builders - UST
GOOGLE_SENDER_EMAIL=aws.cics@ust.edu.ph
GOOGLE_REPLY_TO_EMAIL=aws.cics@ust.edu.ph
GOOGLE_SIGNATORY_NAME=Claire
MESSENGER_GC_LINK=
APP_BASE_URL=http://localhost:3000
EMAIL_ENABLED=false
RECRUITMENT_YEAR=2026

# Applicant edits and interview rescheduling are allowed before this instant.
# Include a timezone offset; this example is September 30 at 11:59 PM in Manila.
APPLICATION_EDIT_DEADLINE=2026-09-30T23:59:59+08:00

# --- CDK deploy target (yours to fill in when you deploy) ---
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=ap-southeast-1
