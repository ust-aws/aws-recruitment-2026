{
  "name": "aws-recruitment-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up postgres localstack & pnpm -r --parallel dev",
    "db:up": "docker compose up -d postgres localstack",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:push": "pnpm --filter backend db:push",
    "db:sync": "pnpm --filter backend db:sync",
    "db:seed": "pnpm --filter backend db:seed",
    "test": "pnpm --filter backend test",
    "deploy": "pnpm --filter backend deploy",
    "doctor": "npx react-doctor@latest",
    "test:csv": "pnpm --filter backend exec tsx --test ../frontend/src/lib/hr-applications-csv.test.ts"
  },
  "dependencies": {
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "react-doctor": "^0.9.12"
  }
}
